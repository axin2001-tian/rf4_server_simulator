+package gameserver
+
+import (
+	"testing"
+	"time"
+)
+
+// TestFishAnnouncedWindow 回归：落地播报去重窗口内命中同鱼，跨窗/异鱼不命中。
+func TestFishAnnouncedWindow(t *testing.T) {
+	sess := &Session{}
+	sess.markFishAnnounced("g1")
+	if !sess.fishAnnounced("g1") {
+		t.Fatal("刚记录的鱼应在窗口内")
+	}
+	if sess.fishAnnounced("g2") {
+		t.Fatal("其他 GUID 不应命中")
+	}
+	sess.landedMu.Lock()
+	sess.landedAt = time.Now().Add(-fishAnnouncedWindow - time.Second)
+	sess.landedMu.Unlock()
+	if sess.fishAnnounced("g1") {
+		t.Fatal("超窗后不应命中")
+	}
+}
diff --git a/internal/gameserver/fishing.go b/internal/gameserver/fishing.go
index d422dbf..fde83e6 100644
--- a/internal/gameserver/fishing.go
+++ b/internal/gameserver/fishing.go
@@ -1505,6 +1505,31 @@ func (s *Session) claimFishPush(guid string) bool {
 	return true
 }
 
+// markFishAnnounced 记录该鱼已发过落地播报（窗口内 notifyFishKept 跳过）。
+func (s *Session) markFishAnnounced(guid string) {
+	if guid == "" {
+		return
+	}
+	s.landedMu.Lock()
+	s.landedGUID = guid
+	s.landedAt = time.Now()
+	s.landedMu.Unlock()
+}
+
+// fishAnnouncedWindow 落地播报后抑制同鱼“入护”行的窗口
+// （入护结算可能晚于落地播报数秒，窗口取宽些）。
+const fishAnnouncedWindow = 30 * time.Second
+
+// fishAnnounced 该鱼是否刚发过落地播报（与 markFishAnnounced 同窗口）。
+func (s *Session) fishAnnounced(guid string) bool {
+	if guid == "" {
+		return false
+	}
+	s.landedMu.Lock()
+	defer s.landedMu.Unlock()
+	return s.landedGUID == guid && time.Since(s.landedAt) < fishAnnouncedWindow
+}
+
