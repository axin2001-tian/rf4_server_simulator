- 跑鱼提示改走 401.f0 kind3（蓝色 KV 模板）：文案“你的 [档位]鱼名，
  跑掉了，<随机语气词>！”，重量走键2（客户端模板句尾显示“X 克/公斤”）
- fish_escape_taunt 开关（默认 1）：置 0 回退官方类型 7“鱼脱钩了”模板
- 面板新增“跑鱼提示”独立分组，开关为点击切换按钮
- 官方分原因模板映射 escapeTemplateKind 保留备查
---
 internal/admin/web/index.html  | 12 ++++++++-
 internal/gameserver/fishing.go | 49 +++++++++++++++++++++++++++++-----
 2 files changed, 54 insertions(+), 7 deletions(-)

diff --git a/internal/admin/web/index.html b/internal/admin/web/index.html
index 43159fa..db2ee78 100644
--- a/internal/admin/web/index.html
+++ b/internal/admin/web/index.html
@@ -151,13 +151,18 @@ const TUNABLE_DEFS=[
   ['fish_tv_channel','鱼汛聊天通道（24..31，27=公聊）',27],
   ['fish_tv_kind','鱼汛消息类型（401.f0，0=发言）',0],
   ['fish_tv_kv','鱼汛KV参数（1=鱼名+重量，未确认前勿开）',0],
+  ['fish_escape_taunt','跑鱼嘲讽文案（1=随机嘲讽，0=官方“鱼脱钩了”）',1],
 ];
 async function loadTunables(){
  const t=await api('/api/tunables');
- const groups=[['咬钩与鱼饵',['bite_probability','bite_delay_fixed','bite_delay_scale','bite_delay_max','bite_delay_lure_max','bait_pref_scale','bait_pref_weight_shift']],['鱼体与搏斗',['fish_weight_scale','fish_weight_cap','hook_entry_cap','fight_power_scale']],['经验与结算',['xp_gain','release_xp_ratio','settle_scale_debug']],['鱼汛播报',['fish_tv_channel','fish_tv_kind','fish_tv_kv']]];
+ const groups=[['咬钩与鱼饵',['bite_probability','bite_delay_fixed','bite_delay_scale','bite_delay_max','bite_delay_lure_max','bait_pref_scale','bait_pref_weight_shift']],['鱼体与搏斗',['fish_weight_scale','fish_weight_cap','hook_entry_cap','fight_power_scale']],['经验与结算',['xp_gain','release_xp_ratio','settle_scale_debug']],['鱼汛播报',['fish_tv_channel','fish_tv_kind','fish_tv_kv']],['跑鱼提示',['fish_escape_taunt']]];
 
  $('#tunablesBody').innerHTML=groups.map(([title,keys])=>'<section class="tunable-group"><h3>'+title+'</h3><div class="tunable-fields">'+keys.map(key=>{
  const [,label,def]=TUNABLE_DEFS.find(x=>x[0]===key);
+ if(key==='fish_escape_taunt'){
+  const on=parseFloat(String(t[key]??'1'))>0;
+  return '<div class="tunable-field"><label>跑鱼提示（点击切换）</label><div><button class="btn sm" style="min-width:230px;'+(on?'background:#2f7d4f;border-color:#2f7d4f':'opacity:.6')+'" onclick="saveTunableVal(\'fish_escape_taunt\','+(on?0:1)+')">'+(on?'嘲讽文案：开（点击关闭）':'官方"鱼脱钩了"（点击开启嘲讽）')+'</button></div></div>';
+ }
  return '<div class="tunable-field"><label for="tun_'+key+'">'+esc(label)+'</label><div><input type="number" step="any" id="tun_'+key+'" value="'+esc(String(t[key]??''))+'" placeholder="默认 '+def+'"><button class="btn alt sm" onclick="saveTunable(\''+key+'\')">保存</button></div>'+'</div>';
  }).join('')+'</div></section>').join('')
  +'<section class="tunable-group"><h3>通道测试（立即推送，探测 24..31 的客户端表现）</h3><div class="tunable-fields">'
@@ -176,6 +181,11 @@ async function fishTVTest(){
   await api('/api/fish_tv_test',{method:'POST',body:JSON.stringify({uid:0,channel:ch,kind:kind||0,text,kv_shape:shape,species:fish,weight_g:w})});
   toast('已发送 ch='+ch+' kind='+(kind||0)+' shape='+shape+'（约 2 秒内到达）');
 }
+async function saveTunableVal(key,val){
+  await api('/api/tunables',{method:'POST',body:JSON.stringify({key,value:String(val)})});
+  toast('已保存，最多 30 秒生效');
+  loadTunables();
+}
 async function saveTunable(key){
   const v=$('#tun_'+key).value.trim();
   if(v===''){toast('请输入数值','bad');return}
diff --git a/internal/gameserver/fishing.go b/internal/gameserver/fishing.go
index d422dbf..dd1c876 100644
--- a/internal/gameserver/fishing.go
+++ b/internal/gameserver/fishing.go
@@ -1912,6 +1912,8 @@ func (s *Server) notifyFishReleased(sess *Session, f *RolledFish) {
 // escapeTemplateKind 跑鱼原因 → 官方聊天模板类型（401.f0）。
 // 客户端内置本地化模板：4=鱼线轮损坏 5=鱼竿损坏 6=鱼线拉断
 // 7=鱼脱钩 10=牙齿咬断钓组 30=引线(子线)断了。
+// 当前跑鱼提示统一改用 kind3 蓝色自由文案（见 notifyFishEscape），
+// 本映射保留备查；恢复官方分原因文案时改回对应 pushChatProbe 即可。
 var escapeTemplateKind = map[string]int{
 	"脱钩离开": 7,
 	"断主线":  6, "断子线": 30,
@@ -1920,19 +1922,54 @@ var escapeTemplateKind = map[string]int{
 	"钓组组件断裂": 10,
 }
 
-// notifyFishEscape 在鱼丢失（脱钩/断线/超时等）时经聊天频道推送提示。
-// 官方模板样式（"player 鱼线拉断了"）；未知原因回退自由文本。
+// fishEscapeTaunts 跑鱼语气词池：随机抽一条拼进跑鱼提示。
+var fishEscapeTaunts = []string{
+	"真是FW啊",
+	"这都能跑",
+	"煮熟的鸭子飞了",
+	"手滑了吧",
+	"竿子太拉了",
+	"鱼比人聪明",
+	"白忙活一场",
+	"差亿点点",
+	"又给跑了",
+	"空军预定",
+	"打龟佬",
+}
+
+// notifyFishEscape 跑鱼提示：类型3（蓝色 KV 模板），文案带随机语气词，
+// 重量走键2（客户端模板句尾自动显示“X 克/公斤”）。
+// fish_escape_taunt=0 时回退官方类型7模板（“鱼脱钩了”）。
 func (s *Server) notifyFishEscape(sess *Session, f *RolledFish, reason string) {
 	if s == nil || sess == nil {
 		return
 	}
-	if kind, ok := escapeTemplateKind[reason]; ok {
-		sess.pushChatProbe(27, kind, "", nil)
+	if s.tunableF("fish_escape_taunt", 1) == 0 {
+		sess.pushChatProbe(27, 7, "", nil)
 		return
 	}
-	if text := s.fishEscapeText(f, reason); text != "" {
-		sess.pushSystemChat(text)
+	weight := int64(0)
+	name := ""
+	tier := ""
+	if f != nil {
+		if f.WeightG > 0 {
+			weight = f.WeightG
+		}
+		name = s.speciesZhName(s.dbCtx(), f.Species)
+		if name == "" {
+			name = f.Species
+		}
+		if f.Grade >= 4 {
+			tier = "超级稀有 "
+		} else if f.Grade == 3 {
+			tier = "稀有 "
+		}
 	}
+	taunt := fishEscapeTaunts[rand.Intn(len(fishEscapeTaunts))]
+	// 客户端 KV 模板恒在句尾追加“X 克/公斤”段（缺键2 显示“0 克”），
+	// 重量只能放句尾：文案不带重量数字，键2 带真实重量。
+	text := "你的 " + tier + name + "，跑掉了，" + taunt + "！"
+	sess.pushChatProbe(27, 3, "", fishTVKv(text, weight))
 }
 
 // bumpFishingCounter 增加玩家钓鱼计数器（escapes 等），幂等累加。
